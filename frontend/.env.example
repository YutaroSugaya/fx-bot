# Copy to frontend/.env.local (gitignored). NEXT_PUBLIC_* は next dev / build の起動時に埋め込まれる。

# Go backend base URL. The Next.js server proxies /api/* here.
# localhost ではなく 127.0.0.1 を使う: localhost は IPv6(::1) にも解決され、
# Node が ::1 を優先して `ECONNREFUSED ::1:8080` を起こすことがあるため。
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080

# 表示スコープ(表示専用・DB は変えない)。未設定なら絞らない。
# 戦績を opened_at がこの時刻以降の trade に絞る(戦略を切り替えた時刻など)。
# NEXT_PUBLIC_TRADES_DISPLAY_EPOCH=2020-01-06T07:00:00+09:00
# per-symbol 表示に出すペア(カンマ区切り)。OPEN ポジションのあるペアは常に表示される。
# NEXT_PUBLIC_DISPLAY_SYMBOLS=USD_JPY

# DNS rebinding 対策: ダッシュボード(ページと /api の proxy)は Host ヘッダが localhost / 127.0.0.1 / [::1]
# のときだけ応答する(proxy.ts)。別のホスト名で開くなら、その名前をカンマ区切りで足す。
# DASHBOARD_ALLOWED_HOSTS=my-mac.local
