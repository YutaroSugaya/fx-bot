# =========================================================
# fx-bot environment variables
# Copy this file to `.env` and fill in real values.
# DO NOT COMMIT `.env`. It is gitignored (pre-commit の secret scan も拒否する)。
# 既定は paper(実際には発注しない)側。live に必要な値は空にしてある。
# =========================================================

# ----- GMO コイン外国為替FX API -----
# paper(既定)では不要。live のときだけ必要。
GMO_API_KEY=
GMO_API_SECRET=

# ----- PostgreSQL -----
# docker-compose.yml の postgres(127.0.0.1:5432 のみ公開・パスワードは開発用)を指す。
DATABASE_URL=postgres://fxbot:fxbot@localhost:5432/fxbot?sslmode=disable
# 調査用の SELECT 専用ロール(任意。scripts/db_readonly_role.sql で作る)。
# edge-judge / sweep / spread-calibrate / fee-backfill の dry-run はこちらを優先する。
# ⚠️ .env を自分で読むのは bot / migrate / spread-calibrate だけ。edge-judge・sweep・fee-backfill・backtest を
#    go run で直接動かすときは、使う DSN をシェルで export する。
# DATABASE_URL_RO=postgres://fxbot_ro:<password>@localhost:5432/fxbot?sslmode=disable
# integration テスト用。DB 名は必ず `_test` で終わること(suite が全テーブルを truncate する)。
# INTEGRATION_TEST_DB_URL=postgres://fxbot:fxbot@localhost:5432/fxbot_test?sslmode=disable
# backtest 用のヒストリカル DB(cmd/histdata-ingest の書込先。DB 名は `_backtest` で終わること)。
# BACKTEST_DATABASE_URL=postgres://fxbot:fxbot@localhost:5432/fxbot_backtest?sslmode=disable

# ----- Claude CLI -----
# LLM を呼ぶ経路(advisor / llm_decision / ダッシュボードの「Claude に聞く」)が使う。
# 定期呼び出しは configs/bot_config.yaml で既定 off(ai_advisor / advisor_v2 / llm_decision の
# enabled: true にしたときだけ呼ぶ。利用料・利用枠を消費する)。
# 既定は PATH 上の `claude`(Claude Code CLI・ログイン済みであること)。
# macOS で VSCode 拡張内蔵の claude を使うなら <repo>/tools/claude_latest.sh を指す。
# Claude を呼ばずに動作確認するなら <repo>/tools/fake_claude.sh(macOS)。
CLAUDE_CLI_PATH=claude
# advisor の subprocess の CWD(.claude/agents と prompts/ を読むため)。未設定なら prompt の 2 階層上。
# BOT_PROJECT_ROOT=

# ----- Bot mode -----
# モードは configs/bot_config.yaml の `bot.mode` が SSOT(tracked ファイルは常に paper_config)。
# live を走らせるときは:
#   1. configs/bot_config.live.example.yaml をコピーして configs/bot_config.live.yaml を作る(gitignore)
#   2. 下の BOT_CONFIG_PATH をその live YAML に向ける
#   3. 下の live の確認 env を両方埋める

# ----- Live mode safety gate -----
# bot.mode=live_config だけでは live は走らない。以下 2 つと GMO_API_KEY / GMO_API_SECRET が
# 揃って初めて live 起動。1 つでも欠けると paper_config に自動降格する(WARN ログ・live_guard.go)。
LIVE_TRADING_ENABLED=false
# bot_config の symbols と集合として完全一致(順不同・過不足なし)で承認したことを明示する。
# 例: LIVE_CONFIRM_SYMBOLS=USD_JPY。空のままなら live は起動しない。
# 単一 symbol なら旧名の LIVE_CONFIRM_SYMBOL でも可(multi-symbol では reject される)。
LIVE_CONFIRM_SYMBOLS=
# 数量上限の SSOT は configs/hard_limits.yaml の quantity.max。

# ----- 設定ファイルのパス -----
# ⚠️ bot は backend/ で起動される(make start / make backend が cd backend する)ため、
#    パスは backend/ からの相対(../ 付き)。未設定なら Makefile の既定値と同じになる。
BOT_CONFIG_PATH=../configs/bot_config.yaml
# BOT_CONFIG_PATH=../configs/bot_config.live.yaml  # ← live 起動時はこちら
HARD_LIMITS_PATH=../configs/hard_limits.yaml
ACTIVE_CONFIG_PATH=../configs/strategy_config.active.yaml
NEXT_CONFIG_PATH=../configs/strategy_config.next.yaml
PROMPT_PATH=../prompts/generate_strategy_config.md
SUMMARY_INPUT_PATH=../runtime/ai_input/latest_summary.json
# AI_OUTPUT_DIR=../runtime/ai_output
# EMERGENCY_FLAG_PATH=../runtime/emergency_stop.flag
# EVENT_CALENDAR_PATH=../configs/event_calendar.yaml

# ----- Dashboard / control API -----
# API の bind address。既定 127.0.0.1:8080(loopback のみ)。0.0.0.0 など loopback の外に
# 向けるときは BasicAuth(下の 2 つ)が必須。認証を外したまま loopback の外に bind すると
# 起動を拒否する(fail-close)。
API_ADDR=127.0.0.1:8080

# BasicAuth。bot.mode=paper_config / live_config では両方必須(欠けると起動しない)。
# /healthz 以外の全 /api(参照の GET も、決済・緊急停止の POST も)に掛かる。必ず変更すること。
# ⚠️ 下の値はプレースホルダ。既定値(change_me_locally 等)のままだと起動を拒否する。loopback の外に
#    bind するなら推測されにくい長いパスワードにし、TLS 終端(reverse proxy 等)の内側に置く。
DASHBOARD_USER=admin
DASHBOARD_PASS=change_me_locally

# CORS allowlist (comma-separated). 未設定なら CORS ヘッダなし = 同一 origin only。
# dashboard を別 origin で動かすときだけ設定。例:
#   DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000,https://dash.example.com
DASHBOARD_ALLOWED_ORIGINS=

# DNS rebinding 対策: loopback bind のとき、API とダッシュボードは Host ヘッダが localhost /
# 127.0.0.1 / [::1] のリクエストにしか応答しない。別のホスト名で開くなら、その名前をカンマ区切りで
# 足す(make start / make frontend なら bot と next dev の両方に渡る。npm を直接動かすなら frontend/.env.local にも書く)。
# DASHBOARD_ALLOWED_HOSTS=my-mac.local

# "true" のとき BasicAuth を外す(起動ログに WARN api_auth_bypass_via_env が出る)。
# loopback bind のときだけ有効で、それ以外の API_ADDR では起動を拒否する。
DASHBOARD_AUTH_DISABLE=false

# LOG_LEVEL=info
