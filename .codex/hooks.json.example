{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'<REPO_ROOT>/.codex/hooks/pre-stop-checks.sh'"
          },
          {
            "type": "command",
            "command": "'<REPO_ROOT>/.codex/hooks/docs-sync-check.sh'"
          }
        ]
      }
    ]
  }
}
